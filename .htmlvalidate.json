{
  "extends": [
    "html-validate:recommended",
    "html-validate:document",
    "html-validate:standard"
  ],
  "rules": {
    "no-multiple-h1": "error",
    "element-required-content": "error",
    "no-implicit-button-type": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error",
    "require-sri": "off",
    "long-title": "off"
  }
}
